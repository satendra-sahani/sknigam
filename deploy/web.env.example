# Copy to deploy/web.env on the VPS and fill in REAL values.
#
# IMPORTANT: NEXT_PUBLIC_* variables are inlined at BUILD time, not runtime.
# They must be present in the environment when you run `npm run build:web`.
# Changing them later requires a rebuild.

PORT=3004

# Public origin of the API + realtime, as seen from the browser. With the
# provided nginx config both are served off the main domain:
NEXT_PUBLIC_API_URL=https://pollistics.com/api
NEXT_PUBLIC_SOCKET_URL=https://pollistics.com
