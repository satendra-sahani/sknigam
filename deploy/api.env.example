# Copy to deploy/api.env on the VPS and fill in REAL values. Never commit the
# filled-in file (deploy/*.env is gitignored). Values marked (required) must be
# set or the API will fail to start / core features break.

NODE_ENV=production
PORT=9003

# --- Database (required) ---------------------------------------------------
# Local mongod:  mongodb://127.0.0.1:27017/pollistics
# Atlas:         mongodb+srv://user:pass@cluster.mongodb.net/pollistics
MONGODB_URI=

# --- Auth (required) -------------------------------------------------------
JWT_SECRET=            # long random string, e.g. `openssl rand -hex 48`
JWT_EXPIRY=7d
OTP_EXPIRY_MINUTES=10

# --- Payments (Razorpay — required for bookstore checkout) -----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Media (ImageKit — required for book covers / uploads) -----------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Offline vision parser (Ollama + Qwen2.5-VL) ---------------------------
# Heavy (multi-GB model, needs RAM/CPU or GPU). Only required if you use the
# voter-roll OCR import. Point at an Ollama host; leave defaults otherwise.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_KEEP_ALIVE=5m
LOCAL_VISION_CONCURRENCY=1
LOCAL_VISION_DPI=200
LOCAL_VISION_TIMEOUT_MS=120000

# --- Misc ------------------------------------------------------------------
GPS_RADIUS_METERS=200
